# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá las mismas variables en Settings → Environment Variables.

# Contraseña del panel /admin (8 caracteres o más).
ADMIN_PASSWORD=

# Base de datos de reseñas (Upstash Redis). Si conectás Upstash desde
# Vercel (Storage → Upstash for Redis), estas dos se crean solas.
# En desarrollo se pueden dejar vacías: se usa el archivo .data/store.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
