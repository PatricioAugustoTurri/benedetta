# Copia questo file come .env.local e completa i valori.

# PostgreSQL. Il database deve esistere e avere la tabella works:
#   createdb illustrando
#   psql -d illustrando -f db/schema.sql
DATABASE_URL=postgresql://utente@localhost:5432/illustrando

# La password di /admin. Senza questa, l'admin resta chiuso.
ADMIN_PASSWORD=

# Cloudinary — dove vivono le immagini dell'opera.
# Si trovano nel pannello: Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Solo se il tuo account è configurato su SHA-256. Per impostazione predefinita, SHA-1.
# CLOUDINARY_SIGNATURE_ALGORITHM=sha256

# Resend — la posta del modulo di contatto, degli ordini e della newsletter
# (vedi src/lib/correo.ts). La newsletter usa lo stesso mittente.
# La chiave si crea su resend.com → API Keys.
RESEND_API_KEY=
# Il mittente. Deve essere di un dominio verificato su Resend (Domains).
# Finché non c'è un dominio, lasciarlo vuoto: si usa onboarding@resend.dev,
# che però consegna SOLO all'indirizzo con cui è stato aperto l'account Resend,
# quindi la conferma al visitatore non arriva.
# CONTACTO_DESDE=Benedetta Zibetti <contatti@benedettazibetti.com>
# Dove arrivano i messaggi. Se manca, l'email di src/data/site.ts.
# CONTACTO_PARA=

# SumUp — il pagamento delle stampe (vedi src/lib/sumup.ts). Lo stesso conto
# con cui lei incassa ai mercatini.
# La chiave si crea nel pannello di SumUp, nella parte per sviluppatori
# (API keys). Il codice esercente è quello del profilo dell'account.
# Per provare senza muovere denaro: Developer Settings → Sandboxes, crea un
# conto di prova e usa la sua chiave e il suo codice, con SUMUP_PROVA=1.
# La carta di prova è 4200 0000 0000 0091, data futura, CVV qualsiasi.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# 1 finché si usa il conto di prova: il carrello e l'admin lo dicono.
SUMUP_PROVA=
# L'avviso dei pagamenti arriva da solo a https://<dominio>/api/sumup/webhook:
# il sito lo indica a SumUp a ogni pagamento, non si configura nel pannello.
# In locale (http) SumUp non può raggiungerlo, e l'ordine lo scrive la pagina
# /carrello/grazie al ritorno.

# Statistiche delle visite con Umami (facoltative, senza cookie).
# Si installano su Coolify come servizio; senza queste due righe il sito
# non carica niente. Vedi src/components/Statistiche.tsx.
# NEXT_PUBLIC_UMAMI_SRC=https://statistiche.benedettazibetti.com/script.js
# NEXT_PUBLIC_UMAMI_ID=

