# Copia questo file come .env.local e completa i valori.

# PostgreSQL. Il database deve esistere e avere la tabella works:
#   createdb illustrando
#   psql -d illustrando -f db/schema.sql
DATABASE_URL=postgresql://utente@localhost:5432/illustrando

# La password di /admin. Senza questa, l'admin resta chiuso.
ADMIN_PASSWORD=

# Cloudinary — dove vivono le immagini dell'opera.
# Si trovano nel pannello: Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Solo se il tuo account è configurato su SHA-256. Per impostazione predefinita, SHA-1.
# CLOUDINARY_SIGNATURE_ALGORITHM=sha256

# Resend — la posta del modulo di contatto (vedi src/lib/correo.ts).
# La chiave si crea su resend.com → API Keys.
RESEND_API_KEY=
# Il mittente. Deve essere di un dominio verificato su Resend (Domains).
# Finché non c'è un dominio, lasciarlo vuoto: si usa onboarding@resend.dev,
# che però consegna SOLO all'indirizzo con cui è stato aperto l'account Resend,
# quindi la conferma al visitatore non arriva.
# CONTACTO_DESDE=Benedetta Zibetti <contatti@benedettazibetti.com>
# Dove arrivano i messaggi. Se manca, l'email di src/data/site.ts.
# CONTACTO_PARA=
