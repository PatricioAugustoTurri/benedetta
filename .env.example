# Copiá este archivo como .env.local y completá los valores.

# PostgreSQL. La base tiene que existir y tener la tabla works:
#   createdb illustrando
#   psql -d illustrando -f db/schema.sql
DATABASE_URL=postgresql://usuario@localhost:5432/illustrando

# La clave de /admin. Sin esto, el admin queda cerrado.
ADMIN_PASSWORD=

# Cloudinary — donde viven las imágenes de la obra.
# Están en el panel: Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Sólo si tu cuenta está configurada en SHA-256. Por defecto, SHA-1.
# CLOUDINARY_SIGNATURE_ALGORITHM=sha256
